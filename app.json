{
  "expo": {
    "name": "Sakina",
    "slug": "islamic-guidance-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07111E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lelahmed.sakina",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#040D1A"
      },
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "package": "com.lelahmed.sakina"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-font", "expo-audio", "expo-sqlite", "expo-asset", "expo-notifications"],
    "extra": {
      "eas": {
        "projectId": "48691805-9833-4c4d-a8a6-c6bf5a054f1a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/48691805-9833-4c4d-a8a6-c6bf5a054f1a",
      "fallbackToCacheTimeout": 3000
    }
  }
}
