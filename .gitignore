# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
build/

# Script output files
scripts/output/

# Local agent / editor tooling (installed per-developer, often via symlinks —
# not part of the app and breaks the EAS archive on Windows)
/skills/
.claude/
.agents/
.agent/
.claire/
.codebuddy/
.codex/
.continue/
.cursor/
.gemini/
.github/prompts/
.github/hooks/
.kiro/
.opencode/
.qoder/
.roo/
.trae/
.windsurf/
.vscode/
skills-lock.json

# Test / coverage artifacts
coverage/

# Supabase CLI local link cache (machine-local project ref, not shared state)
supabase/.temp/

# Raw device screenshots used as compositor input for store assets —
# personal captures, not meant to live in the repo. Re-supply locally
# when regenerating store-assets/app-store/_compose-real.js output.
store-assets/app-store/real-screenshots/
