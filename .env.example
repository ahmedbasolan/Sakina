# Sakina — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ── Supabase (required) ──────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── PostHog Analytics / Crash Reporting (required in production) ─────
# Leave blank in development to disable PostHog event capture.
POSTHOG_API_KEY=phc_your_posthog_api_key

# ── Quran.Foundation API Credentials ────────────────────────────────
# Pre-Production (Testing)
QURAN_API_TEST_CLIENT_ID=your_test_client_id
QURAN_API_TEST_CLIENT_SECRET=your_test_client_secret
QURAN_API_TEST_ENDPOINT=https://prelive-oauth2.quran.foundation

# Production
QURAN_API_CLIENT_ID=your_production_client_id
QURAN_API_CLIENT_SECRET=your_production_client_secret
QURAN_API_ENDPOINT=https://oauth2.quran.foundation

# Set to 'production' or 'test'
QURAN_API_ENV=test

# ── RevenueCat SDK Keys ───────────────────────────────────────────────
# Get from: app.revenuecat.com → Project: Sakina → API Keys → SDK API keys
# Android key starts with goog_  |  iOS key starts with appl_
REVENUECAT_ANDROID_API_KEY=goog_your_android_sdk_key
REVENUECAT_IOS_API_KEY=appl_your_ios_sdk_key
